# Backend'i Docker kullanmadan (npm start) çalıştırırken kullanın.
# Kopyala: copy .env.example .env  (veya cp)

PORT=3000

# PostgreSQL (yerel kurulum; Docker'da compose farklı host kullanır)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gym_app_db
DB_USER=postgres
DB_PASSWORD=postgres

# JWT — üretimde güçlü ve rastgele bir değer kullanın
JWT_SECRET=degistir_guclu_bir_sirre
JWT_EXPIRES_IN=7d

# Google Gemini (AI; boş bırakılabilir)
GEMINI_API_KEY=

# Redis (önbellek; kapatmak için: false)
REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_CONNECT_TIMEOUT_MS=5000

# İsteğe bağlı Redis TTL (saniye); tanımlamazsanız kod içi varsayılanlar kullanılır
# REDIS_TTL_ANSWER_SECONDS=1800
# REDIS_TTL_NUTRITION_PLAN_SECONDS=3600
# REDIS_TTL_SUGGEST_FOODS_SECONDS=1800
# REDIS_TTL_EXERCISE_PROGRAM_SECONDS=3600

# İsteğe bağlı: tek satırda Redis (varsa host/port yerine kullanılabilir)
# REDIS_URL=redis://:sifre@localhost:6379
