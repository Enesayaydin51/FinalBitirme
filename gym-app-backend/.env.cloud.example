# Bulut (Render / Railway) — panelde bu değişkenleri tanımlayın

NODE_ENV=production
PORT=3000

# Render PostgreSQL bağlantısı (otomatik gelir)
DATABASE_URL=postgresql://user:pass@host/dbname

JWT_SECRET=uzun_rastgele_bir_sifre
JWT_EXPIRES_IN=7d

GEMINI_API_KEY=

# Ücretsiz planda Redis yoksa:
REDIS_ENABLED=false

# İsteğe bağlı Redis (Railway Redis vb.)
# REDIS_ENABLED=true
# REDIS_URL=redis://...

CORS_ORIGIN=*
